{
  "expo": {
    "name": "TeamOnSite",
    "slug": "teamonsite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "teamonsite",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.infiniteql.teamonsite"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111110",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.infiniteql.teamonsite",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "TeamOnSite needs camera access to scan QR codes on equipment."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TeamOnSite needs photo library access to attach site photos to tickets."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#f97316"
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TeamOnSite needs your location to record GPS check-in/check-out for attendance."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eb6e8ec6-5549-42a7-9168-1bfe18396d27"
      }
    },
    "owner": "nish8894"
  }
}
